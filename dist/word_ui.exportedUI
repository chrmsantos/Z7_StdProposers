<mso:cmd app="Word" dt="1" /><mso:customUI xmlns:x1="http://schemas.microsoft.com/office/2009/07/customui/macro" xmlns:msox="http://schemas.microsoft.com/office/2006/01/customui/special" xmlns:mso="http://schemas.microsoft.com/office/2009/07/customui"><mso:ribbon><mso:qat><mso:sharedControls><mso:control idQ="mso:AutoSaveSwitch" visible="true"/><mso:control idQ="mso:FileNewDefault" visible="false"/><mso:control idQ="mso:FileOpenUsingBackstage" visible="false"/><mso:control idQ="mso:FileSave" visible="true"/><mso:control idQ="mso:FileSendAsAttachment" visible="false"/><mso:control idQ="mso:FilePrintQuick" visible="false"/><mso:control idQ="mso:PrintPreviewAndPrint" visible="false"/><mso:control idQ="mso:WritingAssistanceCheckDocument" visible="false"/><mso:control idQ="mso:ReadAloud" visible="false"/><mso:control idQ="mso:Undo" visible="true"/><mso:control idQ="mso:RedoOrRepeat" visible="true"/><mso:control idQ="mso:TableDrawTable" visible="false"/><mso:control idQ="mso:PointerModeOptions" visible="false"/><mso:separator idQ="msox:sep1" visible="true"/><mso:button idQ="x1:PadronizarDocumentoMain_1" visible="true" label="Padronizar Propositura" imageMso="ResultsPaneStartFindAndReplace" onAction="PadronizarDocumentoMain"/><mso:button idQ="x1:CorrigirProposituraComIA_1" visible="true" label="Corrigir Seleção com IA" imageMso="TagMarkComplete" onAction="CorrigirProposituraComIA"/><mso:button idQ="x1:AbrirChatIA_1" visible="true" label="Chat com IA - Léia" imageMso="CondolatoryEvent" onAction="AbrirChatIA"/><mso:button idQ="x1:RestaurarBackup_1" visible="true" label="Restaurar Backup" imageMso="InkEraseMode" onAction="RestaurarBackup"/></mso:sharedControls></mso:qat><mso:tabs><mso:tab idQ="mso:TabDrawInk" visible="false"/></mso:tabs></mso:ribbon></mso:customUI>
